{
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/services", "destination": "/#services", "permanent": true },
    { "source": "/services/", "destination": "/#services", "permanent": true },
    { "source": "/drone-survey-:slug*-costa-rica.html", "destination": "/blog/drone-survey-:slug*-costa-rica.html", "permanent": true },
    { "source": "/how-much-does-drone-survey-cost-costa-rica.html", "destination": "/blog/how-much-does-drone-survey-cost-costa-rica.html", "permanent": true },
    { "source": "/lidar-vs-photogrammetry.html", "destination": "/blog/lidar-vs-photogrammetry.html", "permanent": true },
    { "source": "/lidar-vs-photogrammetry-costa-rica.html", "destination": "/blog/lidar-vs-photogrammetry-costa-rica.html", "permanent": true },
    { "source": "/plano-catastro-drone-costa-rica.html", "destination": "/blog/plano-catastro-drone-costa-rica.html", "permanent": true },
    { "source": "/costa-rica-drone-laws-2026.html", "destination": "/blog/costa-rica-drone-laws-2026.html", "permanent": true },
    { "source": "/construction-drone-surveys-costa-rica.html", "destination": "/blog/construction-drone-surveys-costa-rica.html", "permanent": true }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
