# Copy this file to .env and fill in your values
# Then add these same variables to Vercel: Project Settings → Environment Variables

# Anthropic Claude API (for AI chat on quote page — claude.ai)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Notion API Token (from notion.so/my-integrations)
# Database: https://notion.so/2b8f0eb57d154c6e84b40ab2ea584e74
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxx

# Slack Incoming Webhook (posts new quotes to #sales channel)
# To regenerate: api.slack.com/apps → DroneSurveyCR → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T079F128T08/...

# Resend Email API (free at resend.com — 3,000 emails/month)
# 1. Sign up at resend.com
# 2. Add & verify domain: dronesurveycr.com
# 3. Create API key
# Sends from: noreply@dronesurveycr.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
