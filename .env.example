# Copy this file to .env and fill in your values
# Then add these same variables to Vercel: Project Settings → Environment Variables

# Notion API Token (from notion.so/my-integrations)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxx

# CallMeBot WhatsApp (see setup instructions below)
# 1. Save +34 644 44 67 67 in your contacts as "CallMeBot"
# 2. Send "I allow callmebot to send me messages" to that number on WhatsApp
# 3. You'll receive your API key by WhatsApp
CALLMEBOT_PHONE=50672938970
CALLMEBOT_APIKEY=xxxxxxx

# Resend Email API (free at resend.com — 3,000 emails/month)
# 1. Sign up at resend.com
# 2. Add & verify domain: dronesurveycr.com
# 3. Create API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
